@using shop_cart.Services
@implements IDisposable
@inject CartService CartService
@inject NavigationManager Navigation
@inject FilterPanelService FilterPanelService
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="row">
        <div class="col">
            <nav class="navbar navbar-expand-sm navbar-light bg-light fixed-top shadow-sm w-100">
                <div class="container-fluid justify-content-start">

                    <!-- Logo -->
                    <a class="navbar-brand d-flex align-items-center me-3" href="/">
                        <img src="https://getbootstrap.com/docs/5.0/assets/brand/bootstrap-logo.svg"
                             alt="Logo" style="height: 40px;" class="me-2" />
                        <span>MiEmpresa</span>
                    </a>

                    <!-- Botón menú sidebar -->
                    <button class="btn btn-outline-secondary me-3" @onclick="ToggleSidebar">
                        <i class="bi bi-list"></i>
                    </button>

                    <!-- Búsqueda -->
                    @* <div class="flex-grow-1 me-3">
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Buscar productos..."
                                   @bind="_searchTerm"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />
                            <button class="btn btn-outline-secondary" @onclick="Buscar">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div> *@

                    <!-- Búsqueda + botón filtros -->
                    <div class="flex-grow-1 me-3 position-relative">
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   placeholder="Buscar productos..."
                                   @bind="_searchTerm"
                                   @bind:event="oninput"
                                   @onkeydown="OnSearchKeyDown" />

                            <!-- Botón filtros con badge -->
                            <button class="btn btn-outline-secondary d-flex align-items-center gap-1"
                                    @onclick="() => FilterPanelService.Toggle()">
                                <i class="bi bi-sliders"></i>
                                Filtros
                                @if (_activeFilterCount > 0)
                                {
                                    <span class="badge bg-primary rounded-pill">@_activeFilterCount</span>
                                }
                            </button>

                            <button class="btn btn-outline-secondary" @onclick="Buscarv">
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Carrito -->
                    <button class="btn btn-outline-primary position-relative" @onclick="IrAlCarrito">
                        <i class="bi bi-cart"></i>
                        @if (CartService.Count > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                @CartService.Count
                            </span>
                        }
                    </button>

                </div>
            </nav>
        </div>
    </div>
</div>

@code {
    private string _searchTerm = "";

    [Parameter] public int _activeFilterCount { get; set; } = 0;
    [Parameter] public EventCallback OnOpenFilters { get; set; }

    private async Task AbrirFiltros()
        => await OnOpenFilters.InvokeAsync();


    // ── ciclo de vida ─────────────────────────────────────────────
    protected override void OnInitialized()
    {
        // Guardamos referencia al delegate para poder desuscribirnos
        CartService.OnChange += OnCartChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CartService.InitializeAsync();
            StateHasChanged();
        }
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartChanged;
    }

    // ── búsqueda ──────────────────────────────────────────────────
    private void Buscar()
    {
        if (string.IsNullOrWhiteSpace(_searchTerm)) return;
        Navigation.NavigateTo($"/products?q={Uri.EscapeDataString(_searchTerm.Trim())}");
    }
    private void Buscarv()
    {
       
        var term = _searchTerm?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(term))
            Navigation.NavigateTo("/product-search"); // sin ?q= → muestra todos
        else
            Navigation.NavigateTo($"/product-search?q={Uri.EscapeDataString(term)}");

    }

    private void OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Buscarv();
    }

    // ── navegación ────────────────────────────────────────────────
    private void IrAlCarrito()
    {
        Navigation.NavigateTo("/cart");
    }

    private void ToggleSidebar()
    {
        Console.WriteLine("Toggle sidebar");
    }
}